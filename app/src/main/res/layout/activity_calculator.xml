<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.CalculatorActivity">

    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#3C3C3C"
        app:columnCount="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:useDefaultMargins="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202020"
            android:orientation="vertical"
            app:layout_column="0"
            app:layout_columnSpan="4"
            app:layout_row="0">

            <TextView
                android:id="@+id/operationsChain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center_vertical|end"
                android:textAlignment="viewEnd"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/currentNumber"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:fontFamily="monospace"
                android:gravity="center_vertical|end"
                android:textAlignment="viewEnd"
                android:textAppearance="@style/TextAppearance.AppCompat.Display1"
                android:textColor="#FFFFFF"
                android:textSize="50sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/clearAllBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#202020"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="ce"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:layout_column="0"
            app:layout_columnWeight="0.25"
            app:layout_row="1"
            app:layout_rowWeight="0.25"
            tools:text="CE" />

        <TextView
            android:id="@+id/delBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#202020"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="del"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:layout_column="1"
            app:layout_columnWeight="0.25"
            app:layout_row="1"
            app:layout_rowWeight="0.25"
            tools:text="DEL" />

        <TextView
            android:id="@+id/divisionBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#202020"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="/"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="2"
            app:layout_columnWeight="0.25"
            app:layout_row="1"
            app:layout_rowWeight="0.25"
            tools:text="/" />

        <TextView
            android:id="@+id/num7Btn"
            style="@android:style/Widget.Holo.Light.Button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="7"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="0"
            app:layout_columnWeight="0.25"
            app:layout_row="2"
            app:layout_rowWeight="0.25"
            tools:text="7" />

        <TextView
            android:id="@+id/num8Btn"
            style="@android:style/Widget.Holo.Light.Button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="8"
            android:textAlignment="gravity"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="1"
            app:layout_columnWeight="0.25"
            app:layout_row="2"
            app:layout_rowWeight="0.25"
            tools:text="8" />

        <TextView
            android:id="@+id/num9Btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="9"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="2"
            app:layout_columnWeight="0.25"
            app:layout_row="2"
            app:layout_rowWeight="0.25"
            tools:text="9" />

        <TextView
            android:id="@+id/productBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#202020"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="x"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="3"
            app:layout_columnWeight="0.25"
            app:layout_row="1"
            app:layout_rowWeight="0.25"
            tools:text="x" />

        <TextView
            android:id="@+id/num4Btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="4"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            app:layout_column="0"
            app:layout_columnWeight="0.25"
            app:layout_row="3"
            app:layout_rowWeight="0.25"
            tools:text="4" />

        <TextView
            android:id="@+id/num5Btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="5"
            android:textAlignment="gravity"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="1"
            app:layout_columnWeight="0.25"
            app:layout_row="3"
            app:layout_rowWeight="0.25"
            tools:text="5" />

        <TextView
            android:id="@+id/num6Btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="6"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="2"
            app:layout_columnWeight="0.25"
            app:layout_row="3"
            app:layout_rowWeight="0.25"
            tools:text="6" />

        <TextView
            android:id="@+id/sustractBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#202020"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="-"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            android:textSize="58sp"
            app:layout_column="3"
            app:layout_columnWeight="0.25"
            app:layout_row="2"
            app:layout_rowWeight="0.25"
            tools:text="-" />

        <TextView
            android:id="@+id/num1Btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="1"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="0"
            app:layout_columnWeight="0.25"
            app:layout_row="4"
            app:layout_rowWeight="0.25"
            tools:text="1" />

        <TextView
            android:id="@+id/num2Btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="2"
            android:textAlignment="gravity"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="1"
            app:layout_columnWeight="0.25"
            app:layout_row="4"
            app:layout_rowWeight="0.25"
            tools:text="2" />

        <TextView
            android:id="@+id/num3Btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="3"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="2"
            app:layout_columnWeight="0.25"
            app:layout_row="4"
            app:layout_rowWeight="0.25"
            tools:text="3" />

        <TextView
            android:id="@+id/aditionBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#202020"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="+"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="3"
            app:layout_columnWeight="0.25"
            app:layout_row="3"
            app:layout_rowWeight="0.25"
            tools:text="+" />

        <TextView
            android:id="@+id/absoluteBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="+/-"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="0"
            app:layout_columnWeight="0.25"
            app:layout_row="5"
            app:layout_rowWeight="0.25"
            tools:text="+/-" />

        <TextView
            android:id="@+id/num0Btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="0"
            android:textAlignment="gravity"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="1"
            app:layout_columnWeight="0.25"
            app:layout_row="5"
            app:layout_rowWeight="0.25"
            tools:text="0" />

        <TextView
            android:id="@+id/colonBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101010"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text=","
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="2"
            app:layout_columnWeight="0.25"
            app:layout_row="5"
            app:layout_rowWeight="0.25"
            tools:text="," />

        <TextView
            android:id="@+id/equalBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/teal_700"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="="
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#FFFFFF"
            app:layout_column="3"
            app:layout_columnWeight="0.25"
            app:layout_row="4"
            app:layout_rowWeight="0.25"
            tools:text="=" />

        <TextView
            android:id="@+id/returnBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/cp_state"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="0dp"
            android:text="@string/ok"
            android:textColor="#FFFFFF"
            app:layout_column="3"
            app:layout_columnWeight="0.25"
            app:layout_row="5"
            app:layout_rowWeight="0.25" />
    </androidx.gridlayout.widget.GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>