<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="6dp"
            android:paddingLeft="6dp"
            android:paddingEnd="6dp"
            android:paddingRight="6dp"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIcon="@drawable/abc_vector_test" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="55dp"
        android:padding="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/locationCodeTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|center_horizontal"
                    android:gravity="center"
                    android:text="@string/demo_task_code"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/paginationTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/demo_task_pagination"
                    android:textSize="18sp" />

                <Switch
                    android:id="@+id/emptySw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/colorPrimaryVariant"
                    android:hint="@string/mark_empty_location"
                    android:padding="8dp"
                    android:text="@string/mark_empty_location"
                    android:textColor="?attr/colorSecondary"
                    android:textStyle="bold"
                    tools:visibility="gone" />

                <LinearLayout
                    android:id="@+id/editLy"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="false"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/editLayoutLabelTv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:text="@string/adding_new_count"
                            android:textColor="?attr/colorPrimaryVariant"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/finishEditingBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right|top"
                            android:background="@android:color/transparent"
                            android:padding="8dp"
                            android:visibility="invisible"
                            app:srcCompat="@drawable/ic_baseline_close_24" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/sku"
                            app:boxBackgroundColor="#FFFFFF">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/skuEt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableRight="@drawable/ic_baseline_camera_alt_24"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:imeOptions="actionSearch"
                                android:inputType="textPersonName"
                                android:selectAllOnFocus="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:hint="@string/quant"
                            app:boxBackgroundColor="#FFFFFF">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/quantityEt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableRight="@drawable/ic_baseline_calculate_24"
                                android:focusable="true"
                                android:imeOptions="actionSend"
                                android:inputType="number|numberDecimal"
                                android:lines="1"
                                android:maxLines="1"
                                android:minLines="1"
                                android:selectAllOnFocus="true"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/saveBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|right|center_horizontal|end"
                            android:clickable="true"
                            android:cropToPadding="false"
                            android:focusable="true"
                            android:foregroundGravity="center|right|center_horizontal"
                            android:tint="#FFFFFF"
                            app:backgroundTintMode="src_atop"
                            app:fabSize="mini"
                            app:srcCompat="@drawable/ic_baseline_save_24"
                            app:useCompatPadding="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="top"
                        android:foregroundGravity="top"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/descriptionContainer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:hint="@string/description"
                            app:boxBackgroundColor="#FFFFFF"
                            tools:visibility="visible">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/descriptionEt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#FFFFFF"
                                android:inputType="textMultiLine|textPersonName|textImeMultiLine"
                                android:lines="2"
                                android:maxLines="2"
                                android:selectAllOnFocus="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/packagingTv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|fill_vertical"
                            android:layout_weight="0.4"
                            android:foregroundGravity="top"
                            android:gravity="top"
                            android:padding="5dp"
                            android:text="@string/demo_packaging" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/lotContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="@string/lot"
                        app:boxBackgroundColor="#FFFFFF"
                        tools:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/lotEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_baseline_camera_alt_24"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/lpnContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="@string/lpn"
                        app:boxBackgroundColor="#FFFFFF"
                        tools:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/lpnEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_baseline_camera_alt_24"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/createdDateContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="@string/created_date"
                        app:boxBackgroundColor="#FFFFFF"
                        tools:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/createdDateEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_baseline_calendar_today_24"
                            android:inputType="date" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/expiryDateContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="@string/expiry_date"
                        app:boxBackgroundColor="#FFFFFF"
                        tools:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/expiryDateEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_baseline_calendar_today_24"
                            android:inputType="date" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/serialContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="@string/serial"
                        app:boxBackgroundColor="#FFFFFF"
                        tools:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/serialEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/countsLabelTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/counts" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/currentLocationCountRv"
                    android:layout_width="match_parent"
                    android:layout_height="350dp" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <ImageButton
        android:id="@+id/leftBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="8dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/ic_appintro_fab_background"
        app:srcCompat="@drawable/ic_arrow_left___334_" />

    <ImageButton
        android:id="@+id/rightBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|top"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/ic_appintro_fab_background"
        android:tint="#FFFFFF"
        app:srcCompat="@drawable/ic_arrow_right___333_" />

    <TextView
        android:id="@+id/emptyLocationTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|center_vertical"
        android:drawablePadding="15dp"
        android:text="@string/epty_location_msg"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_baseline_delete_outline_24"
        tools:visibility="gone" />

    <TextView
        android:id="@+id/totalCountsTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/total_counts" />

    <Button
        android:id="@+id/doneBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:text="@string/save_pending_counts"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>